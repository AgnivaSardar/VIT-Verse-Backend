{
  "compilerOptions": {
    /* ===============================
       OUTPUT STRUCTURE
    =============================== */
    "rootDir": "./src",
    "outDir": "./dist",

    /* ===============================
       MODULE SYSTEM (Node ESM)
    =============================== */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    /* ===============================
       INTEROP & RUNTIME SAFETY
    =============================== */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* ===============================
       TYPE CHECKING
    =============================== */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,

    /* ===============================
       EMIT OPTIONS
    =============================== */
    "sourceMap": true,
    "declaration": false,
    "removeComments": true,

    /* ===============================
       NODE / JSX
    =============================== */
    "types": ["node"],
    "jsx": "react-jsx"
  },

  /* ===============================
     WHAT TO COMPILE
  =============================== */
  "include": ["src/**/*.ts"],

  /* ===============================
     WHAT TO IGNORE
  =============================== */
  "exclude": [
    "node_modules",
    "dist",
    "prisma",
    "scripts",
      "**/*.test.ts",
      "prisma.config.ts"
  ]
}
