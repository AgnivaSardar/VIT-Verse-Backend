// schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  engineType = "library" 
}

model Users {
  userID    BigInt   @id @default(autoincrement())
  userName  String
  userEmail String   @unique
  userPassword String
  userPhone BigInt?
  role      String   @default("student") // student, teacher, admin
  createdAt DateTime @default(now())
  isActive  Boolean @default(true)
  isEmailVerified Boolean @default(false)
  isSuperAdmin Boolean @default(false)

  student   Student?
  teacher   Teacher?
  channels  Channel[]
  subscriptions Subscription[]
  comments  Comments[]
  likes     Likes[]
  playlists Playlist[]
  notifications Notifications[]
  views     Views[]
  reports   Reports[]        @relation("ReportReporter")

  @@index([userEmail])
  @@index([role])
  @@index([isActive])
  @@index([createdAt(sort: Desc)])
}

model Student {
  studentRegID  String @id
  userID        BigInt @unique
  studentBranch String
  studentYear   Int

  user Users @relation(fields: [userID], references: [userID], onDelete: Cascade)
}

model Teacher {
  teacherID     String @id
  userID        BigInt @unique
  teacherSchool String

  user Users @relation(fields: [userID], references: [userID], onDelete: Cascade)
}

model Channel {
  channelID          BigInt   @id @default(autoincrement())
  publicID           String   @unique @default(dbgenerated("gen_random_uuid()")) // Temporary default for migration
  userID             BigInt
  channelName        String
  channelDescription  String
  channelType        String
  channelImage       String?
  channelSubscribers BigInt   @default(0)
  isPremium          Boolean  @default(false)
  isPresent           Boolean @default(true)
  isAvailableToPublic Boolean @default(true)
  createdAt          DateTime @default(now())

  user          Users          @relation(fields: [userID], references: [userID], onDelete: Cascade)
  videos        Video[]
  subscriptions Subscription[]

  @@index([userID])
  @@index([publicID])
  @@index([isAvailableToPublic])
  @@index([createdAt(sort: Desc)])
  @@index([channelName])
}

model Subscription {
  subID       BigInt   @id @default(autoincrement())
  userID      BigInt
  channelID   BigInt
  subscribedAt DateTime @default(now())

  user    Users   @relation(fields: [userID], references: [userID], onDelete: Cascade)
  channel Channel @relation(fields: [channelID], references: [channelID], onDelete: Cascade)

  @@unique([userID, channelID])
}

model Video {
  vidID       BigInt   @id @default(autoincrement())
  publicID    String   @unique @default(dbgenerated("gen_random_uuid()")) // Temporary default for migration
  channelID   BigInt
  title       String
  description String?
  duration    Int?
  visibility  String   @default("public")
  isAvailableToPublic Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  videoTags             VideoTag[]

  s3Bucket          String?
  s3KeyOriginal     String?
  s3KeyProcessed    String?
  cloudflareVID     String?
  cloudflarePlaybackURL String?
  resolution        String?
  sizeBytes         BigInt?
  codec             String?
  processingStatus  String   @default("UPLOADED")

  channel    Channel      @relation(fields: [channelID], references: [channelID], onDelete: Cascade)
  images     Image[]
  comments   Comments[]
  likes      Likes[]
  playlistVideos PlaylistVideos[]
  views      Views[]
  stats      VideoStats?
  reports    Reports[]

  @@index([channelID])
  @@index([publicID])
  @@index([visibility])
  @@index([isAvailableToPublic])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([processingStatus])
  @@index([channelID, createdAt(sort: Desc)])
  @@index([channelID, isAvailableToPublic])
}

model Image {
  imgID     BigInt   @id @default(autoincrement())
  vidID     BigInt
  s3Bucket  String?
  s3Key     String?
  imgURL    String
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  video Video @relation(fields: [vidID], references: [vidID], onDelete: Cascade)
}

model Comments {
  commID     BigInt   @id @default(autoincrement())
  userID     BigInt
  vidID      BigInt
  description String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  user  Users @relation(fields: [userID], references: [userID], onDelete: Cascade)
  video Video @relation(fields: [vidID], references: [vidID], onDelete: Cascade)
  reports Reports[]
}

model Likes {
  likeID    BigInt   @id @default(autoincrement())
  userID    BigInt
  vidID     BigInt
  createdAt DateTime @default(now())

  user  Users @relation(fields: [userID], references: [userID], onDelete: Cascade)
  video Video @relation(fields: [vidID], references: [vidID], onDelete: Cascade)

  @@unique([userID, vidID])
}

model Playlist {
  pID        BigInt   @id @default(autoincrement())
  publicID   String   @unique @default(dbgenerated("gen_random_uuid()")) // Temporary default for migration
  userID     BigInt
  name       String
  description String?
  isPublic   Boolean  @default(true)
  isPremium  Boolean  @default(false)
  isAvailableToPublic Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  user    Users           @relation(fields: [userID], references: [userID], onDelete: Cascade)
  videos  PlaylistVideos[]

  @@index([publicID])
}

model PlaylistVideos {
  pvID     BigInt   @id @default(autoincrement())
  pID      BigInt
  vidID    BigInt
  position Int
  addedAt  DateTime @default(now())

  playlist Playlist @relation(fields: [pID], references: [pID], onDelete: Cascade)
  video    Video    @relation(fields: [vidID], references: [vidID], onDelete: Cascade)

  @@unique([pID, vidID])
}

model Views {
  viewID    BigInt   @id @default(autoincrement())
  userID    BigInt?
  vidID     BigInt
  watchedAt DateTime @default(now())
  watchTime Int?
  ipAddress String?  // INET -> String in Prisma
  userAgent String?

  user  Users? @relation(fields: [userID], references: [userID], onDelete: SetNull)
  video Video  @relation(fields: [vidID], references: [vidID], onDelete: Cascade)
}

model VideoStats {
  vidID        BigInt   @id
  viewsCount   BigInt   @default(0)
  likesCount   BigInt   @default(0)
  commentsCount BigInt  @default(0)
  sharesCount   BigInt  @default(0)
  createdAt     DateTime @default(now())
  updatedAt    DateTime @default(now())

  video Video @relation(fields: [vidID], references: [vidID], onDelete: Cascade)
}

model Tag {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(200)
  color       String?  @db.VarChar(7) // hex color for UI, e.g. "#FF6B6B"
  usageCount  Int      @default(0)    // how many videos use this tag
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos      VideoTag[] // relation to join table
}

model VideoTag {
  videoID     BigInt
  tagID       BigInt
  assignedAt  DateTime @default(now())

  video       Video @relation(fields: [videoID], references: [vidID], onDelete: Cascade)
  tag         Tag   @relation(fields: [tagID],   references: [id],     onDelete: Cascade)

  @@id([videoID, tagID])
}

model Reports {
  reportID   BigInt   @id @default(autoincrement())
  reporterID BigInt
  reportedUserID BigInt?
  vidID      BigInt?
  commID     BigInt?
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  reporter Users    @relation("ReportReporter", fields: [reporterID], references: [userID], onDelete: Cascade)
  video    Video?   @relation(fields: [vidID], references: [vidID], onDelete: Cascade)
  comment  Comments? @relation(fields: [commID], references: [commID], onDelete: Cascade)
}

model Notifications {
  notifID    BigInt   @id @default(autoincrement())
  userID     BigInt
  type       String   // upload_success, upload_failed, comment, milestone, admin_message, reply, mention, video_processed
  entityID   BigInt?  // videoID, commentID, channelID, etc
  message    String
  isRead     Boolean  @default(false)
  priority   String   @default("normal") // low, normal, high, urgent
  category   String?  // engagement, system, admin, milestone
  metadata   Json?    // {stage: "client|server|storage", commenterName: "...", milestone: 100, videoTitle: "..."}
  createdBy  BigInt?  // For admin notifications - which admin created it
  createdAt  DateTime @default(now())

  user Users @relation(fields: [userID], references: [userID], onDelete: Cascade)

  @@index([userID])
  @@index([userID, isRead])
  @@index([createdAt(sort: Desc)])
  @@index([priority])
}

model Jobs {
  jobID     BigInt   @id @default(autoincrement())
  type      String
  payload   Json
  status    String   @default("PENDING")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
  @@index([type])
  @@index([createdAt(sort: Asc)])
  @@index([status, createdAt])
}
